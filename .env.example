# ─────────────────────────────────────────────────────────────────────────────
# Vantage BTC — server settings. deploy/install.sh creates .env from this file.
# Never commit .env. Avoid the "$" character in values.
# ─────────────────────────────────────────────────────────────────────────────

# Site
APP_NAME=Vantage BTC
# Your web address. No domain? Use <server-ip-with-dashes>.sslip.io, e.g. 141-148-10-20.sslip.io (free, automatic HTTPS)
DOMAIN=
DB_NAME=vantage_btc

# Security (install.sh generates these)
JWT_SECRET=
WEBHOOK_CRON_SECRET=
# First admin account (password is used only to create the account; change it later in Account Settings)
ADMIN_EMAIL=
ADMIN_PASSWORD=
COOKIE_SAMESITE=lax

# ─── Alerts ──────────────────────────────────────────────────────────────────
# Alert mode starts OFF. Turn it ON in Settings → Signal alerts when you are ready.
# Emergency stop: set ALERTS_KILL_SWITCH=true and run: docker compose up -d
ALERTS_KILL_SWITCH=false
ALERT_EMAIL=

# Email — choose ONE free option:
#  A) Gmail: turn on 2-Step Verification, create an App Password (myaccount.google.com/apppasswords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
#  B) Resend (free 3,000/month) — needs a verified sender domain
RESEND_API_KEY=
#  C) Brevo (free 300/day)
BREVO_API_KEY=
EMAIL_FROM_NAME=

# Telegram (free): create a bot with @BotFather, send it any message, then use
# Settings → "Find my Telegram chat ID"
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Phone call through Telegram (free, CallMeBot): send /start to @CallMeBot_txtbot first
CALLMEBOT_USER=
CALLMEBOT_LANG=en-GB-Standard-B
CALLMEBOT_REPEAT=2
CALLMEBOT_CC=missed
ALERT_CALL_COOLDOWN_SEC=300
ALERT_CALL_PROVIDER=

# SMS / normal phone calls (Twilio — paid, optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_PHONE=

# ─── Optional data sources ───────────────────────────────────────────────────
COINGLASS_API_KEY=
# Delta India read-only API key (fills import). Whitelist this server's IP on the key.
DELTA_API_KEY=
DELTA_API_SECRET=

# Optional demo viewer account
SEED_VIEWER=false
VIEWER_EMAIL=
VIEWER_PASSWORD=
